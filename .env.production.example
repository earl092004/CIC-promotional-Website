APP_NAME="City of Ilagan College"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-after-generating-domain.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Set DB_URL in Railway Variables to ${{Postgres.DATABASE_URL}}.
DB_URL=
# Set this Railway build variable so Railpack installs the PostgreSQL driver.
RAILPACK_PHP_EXTENSIONS=pdo_pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_NAME="City of Ilagan College"

VITE_APP_NAME="City of Ilagan College"
